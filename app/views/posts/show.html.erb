<div class="post">
  <h1><%= @post.title %></h1>
  
  <div class="content">
    <%= simple_format(@post.content) %>
  </div>

  <div class="reactions">
    <p class="score">Score: <%= @post.score %></p>
    <%= button_to "👍 Like (#{@post.like_count})", like_post_path(@post), class: "btn" %>
    <%= button_to "👎 Dislike (#{@post.dislike_count})", dislike_post_path(@post), class: "btn" %>
  </div>

  <div class="actions">
    <%= link_to "Back to Posts", posts_path, class: "btn" %>
    <%= link_to "Edit", edit_post_path(@post), class: "btn" %>
    <%= link_to "Delete", post_path(@post), 
        data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
        class: "btn btn-danger" %>
  </div>
</div>
